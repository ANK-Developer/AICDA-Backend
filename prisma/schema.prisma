generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
}

enum GalleryCategory {
  ASSOCIATION
  POLITICAL_ACHIEVEMENT
  IMAGE
  DIRECTORY
  LETTER
}

enum GalleryResourceType {
  IMAGE
  VIDEO
}

model Admin {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  password String

  role     Role    @default(SUPER_ADMIN)
  isActive Boolean @default(true)

  createdById String?

  createdBy Admin?  @relation("AdminCreator", fields: [createdById], references: [id])
  admins    Admin[] @relation("AdminCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id           String              @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  publicId     String
  category     GalleryCategory
  resourceType GalleryResourceType @default(IMAGE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id Int @id @default(autoincrement())

  memberId             Int       @unique
  memberName           String
  fatherName           String?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  dateOfJoining        DateTime?
  validityFrom         DateTime?
  validityTo           DateTime?
  aadharNo             String?
  stateId              Int?
  cityId               Int?
  isActive             Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State? @relation(fields: [stateId], references: [id])
  city  City?  @relation(fields: [cityId], references: [id])

  partners Partner[]
}

model State {
  id        Int    @id @default(autoincrement())
  stateName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Member[]
  cities   City[]
  partners Partner[]
}

model City {
  id       Int    @id @default(autoincrement())
  cityName String
  stateId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State     @relation(fields: [stateId], references: [id])
  members  Member[]
  partners Partner[]

  @@unique([cityName, stateId])
}

model Partner {
  id Int @id @default(autoincrement())

  // 123A, 123B, 123C...
  partnerId     String @unique
  partnerNumber Int

  // Parent Member
  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  // Partner's own information
  partnerName          String
  fatherName           String?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  aadharNo             String?
  designation          String?

  // Copied from Member initially,
  // but editable independently
  companyName      String?
  companyAddress   String?
  companyTelephone String?
  packetNo         String?
  stateId          Int?
  cityId           Int?

  dateOfJoining DateTime?

  // Partner validity
  validityFrom DateTime?
  validityTo   DateTime?

  // Backend controlled
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State? @relation(fields: [stateId], references: [id])
  city  City?  @relation(fields: [cityId], references: [id])

  @@unique([memberId, partnerNumber])
}

model Enquiry {
  id Int @id @default(autoincrement())

  requestType String
  fullName    String
  mobile      String
  email       String?
  companyName String?
  city        String?
  state       String?
  message     String?
  status      String  @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
