generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum GalleryCategory {
  ASSOCIATION
  POLITICAL_ACHIEVEMENT
  IMAGE
  DIRECTORY
  LETTER
}

model Admin {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  password String

  role     Role    @default(ADMIN)
  isActive Boolean @default(true)

  createdById String?

  createdBy Admin?  @relation("AdminCreator", fields: [createdById], references: [id])
  admins    Admin[] @relation("AdminCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id          String          @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  publicId    String
  category    GalleryCategory
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
model Member {
  id Int @id @default(autoincrement())

  memberId             String  @unique
  memberName           String
  fatherName           String?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  dateOfJoining        DateTime?
  aadharNo             String?
  stateId              Int?
  cityId               Int?
  isActive             Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State? @relation(fields: [stateId], references: [id])
  city  City?  @relation(fields: [cityId], references: [id])
}

model State {
  id        Int      @id @default(autoincrement())
  stateName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]
  cities  City[]
}

model City {
  id        Int      @id @default(autoincrement())
  cityName  String
  stateId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state   State    @relation(fields: [stateId], references: [id])
  members Member[]

  @@unique([cityName, stateId])
}
model Enquiry{
  id Int @id @default(autoincrement())

 requestType String
 fullName    String
  mobile      String
  email       String?
  companyName String?
  city        String?
  state       String?
  message     String?
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}