generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
}

enum GalleryCategory {
  ASSOCIATION
  POLITICAL_ACHIEVEMENT
  IMAGE
  DIRECTORY
  LETTER
  BANNER
}

enum GalleryResourceType {
  IMAGE
  VIDEO
}

model Admin {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  password String

  role     Role    @default(SUPER_ADMIN)
  isActive Boolean @default(true)

  createdById String?

  createdBy Admin?  @relation("AdminCreator", fields: [createdById], references: [id])
  admins    Admin[] @relation("AdminCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id           String              @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  publicId     String
  category     GalleryCategory
  resourceType GalleryResourceType @default(IMAGE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Member {
  id                   Int       @id @default(autoincrement())
  memberId             Int       @unique
  memberName           String
  fatherName           String?
  dateOfBirth          DateTime?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  dateOfJoining        DateTime?
  validityFrom         DateTime?
  validityTo           DateTime?
  aadharNo             String?
  stateId              Int?
  district             String?
  cityId               Int?
  isActive             Boolean   @default(true)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  state                State?    @relation(fields: [stateId], references: [id])
  city                 City?     @relation(fields: [cityId], references: [id])

  partners             Partner[]
  renewals             MemberRenewal[]

  @@index([isActive])
  @@index([stateId])
  @@index([cityId])
}

model State {
  id        Int    @id @default(autoincrement())
  stateName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  Member[]
  cities   City[]
  partners Partner[]
}

model City {
  id       Int    @id @default(autoincrement())
  cityName String
  stateId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State     @relation(fields: [stateId], references: [id])
  members  Member[]
  partners Partner[]

  @@unique([cityName, stateId])
}
model Partner {
  id Int @id @default(autoincrement())

  // 123A, 123B, 123C...
  partnerId     String @unique
  partnerNumber Int

  // Parent Member
  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  // Partner's own information
  partnerName          String
  fatherName           String?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  aadharNo             String?
  designation          String?

  // Copied from Member initially,
  // but editable independently
  companyName      String?
  companyAddress   String?
  companyTelephone String?
  packetNo         String?
  stateId          Int?
  cityId           Int?

  dateOfJoining DateTime?

  // Partner validity
  validityFrom DateTime?
  validityTo   DateTime?

  // Backend controlled
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State? @relation(fields: [stateId], references: [id])
  city  City?  @relation(fields: [cityId], references: [id])

  renewals PartnerRenewal[]

  @@unique([memberId, partnerNumber])
  @@index([isActive])
  @@index([stateId])
  @@index([cityId])
}

// One immutable row per offline payment/renewal — never updated or deleted,
// so admins can always answer "when did they pay and what did it cover?"
// even after later renewals move the Member/Partner's own validity dates.
model MemberRenewal {
  id Int @id @default(autoincrement())

  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  amount      Decimal? @db.Decimal(10, 2)
  paymentDate DateTime @default(now())

  validityFrom DateTime
  validityTo   DateTime

  note String?

  createdAt DateTime @default(now())

  @@index([memberId])
}

model PartnerRenewal {
  id Int @id @default(autoincrement())

  partnerId Int
  partner   Partner @relation(fields: [partnerId], references: [id])

  amount      Decimal? @db.Decimal(10, 2)
  paymentDate DateTime @default(now())

  validityFrom DateTime
  validityTo   DateTime

  note String?

  createdAt DateTime @default(now())

  @@index([partnerId])
}

model ImportantDate {
  id Int @id @default(autoincrement())

  title       String
  date        DateTime
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Enquiry {
  id Int @id @default(autoincrement())

  requestType String
  fullName    String
  mobile      String
  email       String?
  companyName String?
  city        String?
  state       String?
  message     String?
  status      String  @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
