generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?  @unique
  password    String
  passwordEnc String?  @db.Text
  role        Role     @default(SUPER_ADMIN)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Admin?   @relation("AdminCreator", fields: [createdById], references: [id])
  admins      Admin[]  @relation("AdminCreator")

  @@index([createdById], map: "Admin_createdById_fkey")
}

model Gallery {
  id           String              @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  category     GalleryCategory
  resourceType GalleryResourceType @default(IMAGE)
  isActive     Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Member {
  id                   Int             @id @default(autoincrement())
  memberId             Int             @unique
  memberName           String
  fatherName           String?
  dateOfBirth          DateTime?
  specialDates         Json?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  dateOfJoining        DateTime?
  validityFrom         DateTime?
  validityTo           DateTime?
  aadharNo             String?
  // Location is plain text, picked from the state/district/city lists in the
  // admin form (a name missing from those lists can still be typed in).
  state                String?
  district             String?
  city                 String?
  // Manual status set by an admin: true = ACTIVE, false = INACTIVE (reason required).
  // Membership validity (expired / days remaining) is calculated from the dates.
  isActive             Boolean         @default(true)
  statusReason         String?         @db.Text
  statusActionBy       String?
  statusActionAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  renewals             MemberRenewal[]
  partners             Partner[]

  @@index([isActive])
  @@index([state])
  @@index([district])
  @@index([city])
}

model Partner {
  id                   Int              @id @default(autoincrement())
  partnerId            String           @unique
  partnerNumber        Int
  memberId             Int
  partnerName          String
  fatherName           String?
  dateOfBirth          DateTime?
  specialDates         Json?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  aadharNo             String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  state                String?
  district             String?
  city                 String?
  dateOfJoining        DateTime?
  validityFrom         DateTime?
  validityTo           DateTime?
  // Manual status set by an admin: true = ACTIVE, false = INACTIVE (reason required).
  // Membership validity (expired / days remaining) is calculated from the dates.
  isActive             Boolean          @default(true)
  statusReason         String?          @db.Text
  statusActionBy       String?
  statusActionAt       DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  member               Member           @relation(fields: [memberId], references: [id])
  renewals             PartnerRenewal[]

  @@unique([memberId, partnerNumber])
  @@index([isActive])
  @@index([state])
  @@index([district])
  @@index([city])
}

model MemberRenewal {
  id           Int      @id @default(autoincrement())
  memberId     Int
  amount       Decimal? @db.Decimal(10, 2)
  paymentDate  DateTime @default(now())
  validityFrom DateTime
  validityTo   DateTime
  note         String?
  createdAt    DateTime @default(now())
  member       Member   @relation(fields: [memberId], references: [id])

  @@index([memberId])
}

model PartnerRenewal {
  id           Int      @id @default(autoincrement())
  partnerId    Int
  amount       Decimal? @db.Decimal(10, 2)
  paymentDate  DateTime @default(now())
  validityFrom DateTime
  validityTo   DateTime
  note         String?
  createdAt    DateTime @default(now())
  partner      Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

model Enquiry {
  id          Int           @id @default(autoincrement())
  requestType String
  fullName    String
  mobile      String
  email       String?
  companyName String?
  city        String?
  state       String?
  message     String?
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Role {
  SUPER_ADMIN
}

enum GalleryCategory {
  ASSOCIATION
  POLITICAL_ACHIEVEMENT
  IMAGE
  DIRECTORY
  LETTER
  BANNER
}

enum GalleryResourceType {
  IMAGE
  VIDEO
}
