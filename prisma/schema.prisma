generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?  @unique
  password    String
  role        Role     @default(SUPER_ADMIN)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Admin?   @relation("AdminCreator", fields: [createdById], references: [id])
  admins      Admin[]  @relation("AdminCreator")

  @@index([createdById], map: "Admin_createdById_fkey")
}

model Gallery {
  id           String              @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  category     GalleryCategory
  resourceType GalleryResourceType @default(IMAGE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Member {
  id                   Int             @id @default(autoincrement())
  memberId             Int             @unique
  memberName           String
  fatherName           String?
  dateOfBirth          DateTime?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  dateOfJoining        DateTime?
  validityFrom         DateTime?
  validityTo           DateTime?
  aadharNo             String?
  stateId              Int?
  district             String?
  cityId               Int?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  city                 City?           @relation(fields: [cityId], references: [id])
  state                State?          @relation(fields: [stateId], references: [id])
  renewals             MemberRenewal[]
  partners             Partner[]

  @@index([isActive])
  @@index([stateId])
  @@index([cityId])
}

model State {
  id        Int       @id @default(autoincrement())
  stateName String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cities    City[]
  members   Member[]
  partners  Partner[]
}

model City {
  id        Int       @id @default(autoincrement())
  cityName  String
  stateId   Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  state     State     @relation(fields: [stateId], references: [id])
  members   Member[]
  partners  Partner[]

  @@unique([cityName, stateId])
  @@index([stateId], map: "City_stateId_fkey")
}

model Partner {
  id                   Int              @id @default(autoincrement())
  partnerId            String           @unique
  partnerNumber        Int
  memberId             Int
  partnerName          String
  fatherName           String?
  photo                String?
  residentialAddress   String?
  mobile               String?
  residentialTelephone String?
  panCardNo            String?
  aadharNo             String?
  designation          String?
  companyName          String?
  companyAddress       String?
  companyTelephone     String?
  packetNo             String?
  stateId              Int?
  cityId               Int?
  dateOfJoining        DateTime?
  validityFrom         DateTime?
  validityTo           DateTime?
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  city                 City?            @relation(fields: [cityId], references: [id])
  member               Member           @relation(fields: [memberId], references: [id])
  state                State?           @relation(fields: [stateId], references: [id])
  renewals             PartnerRenewal[]

  @@unique([memberId, partnerNumber])
  @@index([isActive])
  @@index([stateId])
  @@index([cityId])
}

model MemberRenewal {
  id           Int      @id @default(autoincrement())
  memberId     Int
  amount       Decimal? @db.Decimal(10, 2)
  paymentDate  DateTime @default(now())
  validityFrom DateTime
  validityTo   DateTime
  note         String?
  createdAt    DateTime @default(now())
  member       Member   @relation(fields: [memberId], references: [id])

  @@index([memberId])
}

model PartnerRenewal {
  id           Int      @id @default(autoincrement())
  partnerId    Int
  amount       Decimal? @db.Decimal(10, 2)
  paymentDate  DateTime @default(now())
  validityFrom DateTime
  validityTo   DateTime
  note         String?
  createdAt    DateTime @default(now())
  partner      Partner  @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
}

model ImportantDate {
  id            Int      @id @default(autoincrement())
  title         String
  date          DateTime
  description   String?
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

model Enquiry {
  id          Int      @id @default(autoincrement())
  requestType String
  fullName    String
  mobile      String
  email       String?
  companyName String?
  city        String?
  state       String?
  message     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum Role {
  SUPER_ADMIN
}

enum GalleryCategory {
  ASSOCIATION
  POLITICAL_ACHIEVEMENT
  IMAGE
  DIRECTORY
  LETTER
  BANNER
}

enum GalleryResourceType {
  IMAGE
  VIDEO
}
